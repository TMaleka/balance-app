# Balance App Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control

# Supabase Configuration (REQUIRED)
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Partner API Keys (Optional - for testing merchant integrations)
VITE_TEST_API_KEY_CHECKERS=
VITE_TEST_API_KEY_SHOPRITE=
VITE_TEST_API_KEY_SHELL=
VITE_TEST_API_KEY_ENGEN=
VITE_TEST_API_KEY_KFC=
VITE_TEST_API_KEY_MCDONALD=

# App Configuration (Optional)
VITE_APP_NAME=Balance
VITE_APP_VERSION=1.0.0
VITE_ENVIRONMENT=development
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_NOTIFICATIONS=false
VITE_DEBUG_MODE=false
