# Loyalty System Environment Variables
# Copy this file to .env.local and fill in your values

# Supabase Configuration (already in your .env)
REACT_APP_SUPABASE_URL=your_supabase_url_here
REACT_APP_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Required for database migrations (service role key with admin privileges)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Loyalty System Configuration
LOYALTY_CARD_PREFIX=bal_usr_
LOYALTY_POINTS_EXPIRY_MONTHS=24
LOYALTY_MIN_TRANSACTION_AMOUNT=1.00

# Partner API Configuration
PARTNER_API_RATE_LIMIT=1000
PARTNER_API_TIMEOUT=30000

# Push Notifications (for future implementation)
FIREBASE_SERVER_KEY=your_firebase_server_key_here
FIREBASE_SENDER_ID=your_firebase_sender_id_here

# Security
JWT_SECRET=your_jwt_secret_for_partner_auth
API_ENCRYPTION_KEY=your_32_char_encryption_key_here

# Development/Testing
NODE_ENV=development
LOYALTY_DEBUG=true
MOCK_PARTNER_TRANSACTIONS=false
